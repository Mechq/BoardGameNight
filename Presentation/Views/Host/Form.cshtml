@model Domain.Evening

@{
ViewData["Title"] = "Create New Game Night";
}

<div class="max-w-3xl mx-auto p-8 bg-white shadow-xl rounded-lg">
    <h1 class="text-3xl font-semibold text-center text-gray-800 mb-8">Maak een nieuwe avond aan</h1>

    <form asp-action="Create" class="space-y-6">
        <!-- Host -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            <!-- MaxUsers -->
            <div>
                <label for="MaxUsers" class="block text-sm font-medium text-gray-700">Maximum aantal deelnemers</label>
                <input asp-for="MaxUsers" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="number" min="1" />
            </div>
        </div>

        <!-- HostDate -->
        <div>
            <label for="HostDate" class="block text-sm font-medium text-gray-700">Datum</label>
            <input asp-for="HostDate" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="date" />
        </div>

        <!-- Allergy -->
        <div>
            <label for="Allergy" class="block text-sm font-medium text-gray-700">Allergieën (i.v.t.)</label>
            <input asp-for="Allergy" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="text" placeholder="B.v. noten, kaas" />
        </div>

        <!-- Address -->
        <fieldset class="border border-gray-300 p-4 rounded-lg">
            <legend class="text-lg font-medium text-gray-800">Adres</legend>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
                <div>
                    <label for="Address.Street" class="block text-sm font-medium text-gray-700">Straat</label>
                    <input asp-for="Address.Street" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="text" placeholder="" />
                </div>
                <div>
                    <label for="Address.City" class="block text-sm font-medium text-gray-700">Stad</label>
                    <input asp-for="Address.City" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="text" placeholder="" />
                </div>
                <div>
                    <label for="Address.HouseNumber" class="block text-sm font-medium text-gray-700">Huisnummer</label>
                    <input asp-for="Address.HouseNumber" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" type="text" placeholder="" />
                </div>
            </div>
        </fieldset>

        <!-- BoardGames -->
        <div>
            <label for="BoardGames" class="block text-sm font-medium text-gray-700">Bordspellen</label>
            <select asp-for="BoardGames" asp-items="ViewBag.BoardGames" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" multiple>
                <option value="">Selecteer bordspellen</option>
            </select>
        </div>

        <!-- Submit button -->
        <div class="flex justify-center">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-800 text-white font-bold py-3 px-6 rounded-lg shadow-md">
                Create Game Night
            </button>
        </div>
    </form>
    <a href="@Url.Action("Index", "Host")" class="fixed bottom-6 right-6 bg-[#C70000] hover:bg-red-950 text-white font-bold py-4 px-6 rounded-full shadow-lg">
        Cancel
    </a>
</div>