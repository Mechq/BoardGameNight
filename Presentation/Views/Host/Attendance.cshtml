@model List<Domain.User> 

<div class="min-h-screen flex items-center justify-center bg-gray-100">
    <div class="bg-white rounded-lg shadow-lg p-6 max-w-md w-full">
        <h2 class="text-xl font-semibold text-[#6a9acc] mb-4">Deelnemers</h2>

        <form method="post" action="@Url.Action("Attendance", "Host")">
            <div class="space-y-3">
                @foreach (var participant in Model)
                {
                <div class="flex items-center">
                    <input type="checkbox" id="participant_@(participant.Id)" name="participants" value="@participant.Id" class="mr-2" />
                    <label for="participant_@(participant.Id)" class="text-gray-900">@participant.Name</label>
                </div>
                }
            </div>

            <div class="flex justify-end space-x-4 mt-4">
                <button type="submit" class="px-4 py-2 bg-[#24E0B8] text-white font-bold rounded-lg shadow hover:bg-[#1cbfa0]">Opslaan</button>
                <a href="@Url.Action("Index", "Host")" class="px-4 py-2 bg-gray-300 text-gray-800 font-bold rounded-lg shadow hover:bg-gray-400">Annuleren</a>
            </div>
        </form>
    </div>
</div>
