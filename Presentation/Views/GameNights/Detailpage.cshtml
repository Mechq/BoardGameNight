@model Presentation.ViewModels.GameNightViewModel



    <div class="flex items-center justify-center min-h-screen relative z-10">
        <div class="bg-white rounded-lg shadow-lg p-8 max-w-3xl w-full">
            <h1 class="text-3xl font-bold text-center text-[#6a9acc] mb-4">Game Night Details</h1>

            <!-- Host Info -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Host:</h2>
                <p class="text-gray-900 text-lg">@(Model.Host?.Name ?? "Unknown")</p>
            </div>

            <!-- Date and Time -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Date and Time:</h2>
                <p class="text-gray-900 text-lg">@Model.GameNight?.HostDate.ToString("d")</p>
            </div>

            <!-- Address -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Location:</h2>
                <p class="text-gray-900 text-lg">@Model.GameNight?.Address?.Street, @Model.GameNight?.Address?.City</p>
            </div>

            <!-- Allergy Info -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Allergy Information:</h2>
                <p class="text-gray-900 text-lg">@(Model.GameNight?.Allergy ?? "None")</p>
            </div>

            <!-- Participants -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Participants:</h2>
                @if (Model.Participants.Any())
                {
                    <ul class="list-disc list-inside">
                        @foreach (var participant in Model.Participants)
                        {
                            <li class="text-gray-900">@(participant?.Name ?? "Unknown")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-900">No participants yet.</p>
                }
            </div>

            <!-- Games -->
            <div class="mt-4">
                <h2 class="text-xl font-semibold text-[#6a9acc]">Games:</h2>
                @if (Model.GameNight.Games.Any())
                {
                    <ul class="list-disc list-inside">
                        @foreach (var game in Model.GameNight.Games)
                        {
                            <li class="text-gray-900">@(game.Game?.Name ?? "Unknown")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-gray-900">No games assigned yet.</p>
                }
            </div>

            <!-- Join Button -->
            <div class="mt-6">
                <a href="@Url.Action("Join", "GameNights", new { id = Model.GameNight.Id })" class="flex w-full justify-center rounded-md bg-[#6a9acc] hover:bg-[#4f7499] text-white font-semibold py-2 transition duration-300">
                    Join Game Night
                </a>
            </div>

            <!-- Back Button -->
            <div class="mt-4">
                <a href="@Url.Action("Index", "GameNights")" class="flex w-full justify-center rounded-md bg-gray-600 hover:bg-gray-800 text-white font-semibold py-2 transition duration-300">
                    Back to Game Nights
                </a>
            </div>
        </div>
    </div>
